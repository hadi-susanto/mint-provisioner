#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${NO_COLOR:-}" ]] &&
    { [[ -n "${FORCE_COLOR:-}" ]] || [[ -t 1 ]]; }; then
    readonly COLOR_RED=$'\033[0;31m'
    readonly COLOR_CYAN=$'\033[0;36m'
    readonly COLOR_RESET=$'\033[0m'
else
    readonly COLOR_RED=""
    readonly COLOR_CYAN=""
    readonly COLOR_RESET=""
fi

__log_error() {
    printf '%s[ERROR]%s %s\n' \
        "$COLOR_RED" \
        "$COLOR_RESET" \
        "$*" >&2
}

__usage() {
    cat <<EOF
${COLOR_CYAN}Usage:${COLOR_RESET}
  kafdrop [OPTIONS]

Run Kafdrop with the configured Kafka brokers and listener port.

${COLOR_CYAN}Options:${COLOR_RESET}
  -h, --help             Display this help message
  -b, --broker BROKER    Configure a Kafka broker
  -p, --port PORT        Configure Kafdrop listener port
      --gui              Always ask for the bootstrap server and port

BROKER uses the [host]:[port] format. Missing host defaults to localhost,
and missing port defaults to 9092.

If no broker is specified, localhost:9092 is used.

If no port is specified, Kafdrop will listen on port 9000.

With --gui, the bootstrap servers (separated by spaces or commas) and port are
prompted for. Any --broker/--port values become the prompt defaults. The desktop
launcher runs 'kafdrop --gui' in a terminal.

${COLOR_CYAN}Examples:${COLOR_RESET}
  kafdrop
  kafdrop --gui
  kafdrop --broker localhost:9094
  kafdrop --broker :9094
  kafdrop --broker my-kafka
  kafdrop -b kafka-1:9092 -b kafka-2:9092
  kafdrop --broker kafka-1 --broker kafka-2:9093 --port 9001
EOF
}

__parse_broker() {
    local broker="$1"
    local host
    local port

    if [[ -z "$broker" || "$broker" == ":" ]]; then
        __log_error "Invalid broker: '$broker'"

        return 2
    fi

    if [[ "$broker" == *:* ]]; then
        host="${broker%%:*}"
        port="${broker#*:}"
    else
        host="$broker"
        port=""
    fi

    [[ -z "$host" ]] && host="localhost"
    [[ -z "$port" ]] && port="9092"

    if [[ ! "$port" =~ ^[0-9]+$ ]]; then
        __log_error "Invalid broker port: '$port'"

        return 2
    fi

    printf '%s:%s\n' "$host" "$port"
}

__pause() {
    local _

    read -r -p "Press Enter to close..." _ || true
}

__prompt_brokers() {
    local default="$1"
    local input
    local entry
    local parsed
    local valid
    local -a entries
    local -a result

    cat >&2 <<EOF
${COLOR_CYAN}Enter one or more Kafka brokers separated by spaces (commas also work):${COLOR_RESET}
  localhost:9092
  kafka-1:9092 kafka-2:9092
  my-kafka          (port defaults to 9092)
  :9094             (host defaults to localhost)
EOF

    while true; do
        if ! read -r -p "Kafka bootstrap server [$default]: " input; then
            __log_error "No input available for --gui."

            return 1
        fi

        input="${input:-$default}"
        read -r -a entries <<<"${input//,/ }"
        result=()
        valid=1

        for entry in "${entries[@]}"; do
            if ! parsed="$(__parse_broker "$entry")"; then
                valid=0
                break
            fi

            result+=("$parsed")
        done

        if ((valid)); then
            (IFS=,; printf '%s\n' "${result[*]}")

            return 0
        fi
    done
}

__prompt_port() {
    local default="$1"
    local input

    while true; do
        if ! read -r -p "Kafdrop port [$default]: " input; then
            __log_error "No input available for --gui."

            return 1
        fi

        input="${input:-$default}"

        if [[ "$input" =~ ^[0-9]+$ ]]; then
            printf '%s\n' "$input"

            return 0
        fi

        __log_error "Invalid Kafdrop listener port: '$input'"
    done
}

__parse_args() {
    local options_name="$1"
    local -n options_ref="$options_name"

    shift

    # BROKERS is a comma-separated broker list; an empty value means none was given.
    options_ref=(
        [BROKERS]=""
        [PORT]="9000"
        [GUI]=0
    )

    while (($# > 0)); do
        case "$1" in
            -h | --help)
                __usage
                exit 0
                ;;

            -b | --broker)
                if (($# < 2)); then
                    __log_error "Option '$1' requires an argument."
                    printf "Run 'kafdrop --help' for usage information.\n" >&2
                    return 2
                fi

                local broker
                if ! broker="$(__parse_broker "$2")"; then
                    printf "Run 'kafdrop --help' for usage information.\n" >&2
                    return 2
                fi

                options_ref[BROKERS]+="${options_ref[BROKERS]:+,}$broker"
                shift 2
                ;;

            -p | --port)
                if (($# < 2)); then
                    __log_error "Option '$1' requires an argument."
                    printf "Run 'kafdrop --help' for usage information.\n" >&2
                    return 2
                fi

                if [[ ! "$2" =~ ^[0-9]+$ ]]; then
                    __log_error "Invalid Kafdrop listener port: '$2'"
                    printf "Run 'kafdrop --help' for usage information.\n" >&2
                    return 2
                fi

                options_ref[PORT]="$2"
                shift 2
                ;;

            --gui)
                options_ref[GUI]=1
                shift
                ;;

            --)
                shift

                if (($# > 0)); then
                    __log_error "Unexpected argument: '$1'"
                    printf "Run 'kafdrop --help' for usage information.\n" >&2
                    return 2
                fi

                return 0
                ;;

            -*)
                __log_error "Unknown option: $1"
                printf "Run 'kafdrop --help' for usage information.\n" >&2
                return 2
                ;;

            *)
                __log_error "Unexpected argument: '$1'"
                printf "Run 'kafdrop --help' for usage information.\n" >&2
                return 2
                ;;
        esac
    done

    if [[ -z "${options_ref[BROKERS]}" ]] && ((!options_ref[GUI])); then
        options_ref[BROKERS]="localhost:9092"

        printf '%s[INFO]%s Using default Kafka broker: localhost:9092\n' \
            "$COLOR_CYAN" \
            "$COLOR_RESET"

        printf '%s[INFO]%s Please use --broker [host]:[port] to override.\n' \
            "$COLOR_CYAN" \
            "$COLOR_RESET"
    fi
}

main() {
    local -A options=()
    local status=0

    __parse_args options "$@"

    if ! command -v java >/dev/null 2>&1; then
        __log_error "java is not installed or is not available in PATH."

        if ((options[GUI])); then
            __pause
        fi

        return 1
    fi

    if ((options[GUI])); then
        options[BROKERS]="$(__prompt_brokers "${options[BROKERS]:-localhost:9092}")" || return $?
        options[PORT]="$(__prompt_port "${options[PORT]}")" || return $?
    fi

    # Ctrl+C reaches this wrapper and java alike. A trap handler (unlike the default action) keeps the wrapper
    # alive, so it can pause afterwards; java still resets the handler and stops on SIGINT.
    if ((options[GUI])); then
        trap ':' INT
    fi

    java \
        --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
        -jar "KAFDROP_BINARY_FILE" \
        "--kafka.brokerConnect=${options[BROKERS]}" \
        "--server.port=${options[PORT]}" \
        "--management.server.port=${options[PORT]}" || status=$?

    trap - INT

    # Keep the launcher's terminal open after Kafdrop stops; 130 is Ctrl+C.
    if ((options[GUI] && status != 0)); then
        if ((status == 130)); then
            printf '%s[INFO]%s Kafdrop stopped.\n' "$COLOR_CYAN" "$COLOR_RESET"
        else
            __log_error "Kafdrop exited with status $status."
        fi

        __pause
    fi

    return "$status"
}

main "$@"
